# --- OpenAI ---
OPENAI_API_KEY=
# модель выбирается при первом живом прогоне (client.models.list())
OPENAI_MODEL=
# 1 — работать на заготовленных ответах без запросов к API (включается и сам, если ключа нет)
KP_MOCK=1

# --- Стоимость (см. README, «Как считается стоимость») ---
# ставка за час, ₽ и $
KP_RATE_RUB=500
KP_RATE_USD=12
# курс для пересчета стоимости токенов в рубли
KP_USD_RUB=80
# сколько часов в день реально уходит на проект клиента — для сроков в КП
KP_HOURS_PER_CLIENT_DAY=4
# время агента × множитель = написание + тесты
KP_TEST_MULTIPLIER=3
# уровни этапов: часы агента, часы коммуникации и деплоя, токены в $
KP_TIER_S=1,2,10
KP_TIER_M=2.5,3,30
KP_TIER_L=6,5,75

# --- Публичное демо (на сервере) ---
# 1 — видны только свои КП, живые генерации ограничены
KP_PUBLIC_DEMO=0
KP_DEMO_MAX_PER_SESSION=5
KP_DEMO_MAX_PER_DAY=50
# обязателен при KP_PUBLIC_DEMO=1: общий ключ сессий для всех процессов gunicorn
# сгенерировать: python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=
# папка с КП; в Docker задается в docker-compose.yml
KP_OUTPUT_DIR=
